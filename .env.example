# ==============================================================
# LA PARDA — KONFIGURATSIYA SOZLAMALARI (ENVIRONMENT VARIABLES)
# ==============================================================

# 1. MA'LUMOTLAR BAZASI (Supabase / PostgreSQL)
# Supabase loyihangiz Settings -> Database -> Connection string (URI) dan oling
# Misol: postgresql://postgres.xxxxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# 2. TELEGRAM BOT SOZLAMALARI
# Telegramda @BotFather orqali bot oching va berilgan tokenni qo'ying:
# Misol: 1234567890:ABCdefGhIJKlmNoPQRstuVWxyz
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER"

# Telegram administratoringizning Chat ID raqami (Buyurtmalar shu chatga boradi)
# O'zingizning Chat ID ingizni bilish uchun @userinfobot ga yozing
# Misol: 987654321
TELEGRAM_ADMIN_CHAT_ID="YOUR_ADMIN_TELEGRAM_CHAT_ID"

# 3. XAVFSIZLIK VA AUTENTIFIKATSIYA
# Sessiyalar va parollar shifrlash kaliti
JWT_SECRET="laparda-secret-jwt-key-2026-tashkent-luxury-curtains"

# 4. SAYT ASOSIY HAVOLASI (Vebhook va havolalar uchun)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 5. ADMIN BO'LISH UCHUN MAXSUS PAROL (Dastlabki admin hisobi yaratishda)
ADMIN_REGISTRATION_SECRET="laparda_admin_master_2026"
